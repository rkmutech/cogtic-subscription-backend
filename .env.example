# SMTP settings for FastAPI-Mail. Use your provider's SMTP host and an
# app-specific password where required (for example, with Gmail).
SMTP_HOST=your-provider-smtp-host
SMTP_PORT=587
SMTP_USERNAME=your-email@example.com
SMTP_PASSWORD=your-app-specific-password
SMTP_USE_TLS=true
# Test messages go to this inbox.
MAIL_TO=your-test-inbox@gmail.com
CORS_ORIGINS=["http://localhost:6001"]
FRONTEND_URL=http://localhost:6001
